# -----------------------------
# Build stage
# -----------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# Enable Corepack and use a fixed pnpm version
RUN apk add --no-cache git openssh-client \
    && mkdir -p -m 0700 /root/.ssh \
    && ssh-keyscan github.com >> /root/.ssh/known_hosts \
    && corepack enable \
    && corepack prepare pnpm@11.12.0 --activate

# Workspace/package files
COPY package.json ./
COPY pnpm-lock.yaml ./
COPY pnpm-workspace.yaml ./
COPY tsconfig.base.json ./

# Libraries
COPY Libraries ./Libraries

# Backends
COPY Backend ./Backend

# Install workspace dependencies
RUN --mount=type=ssh pnpm install --frozen-lockfile

# Build siteSystems service and required workspace dependencies
RUN pnpm --filter @menorahgroupmep/siteSystems... build


# -----------------------------
# Production stage
# -----------------------------
FROM node:22-alpine AS production

WORKDIR /app

RUN corepack enable \
    && corepack prepare pnpm@11.12.0 --activate

# Copy built workspace
COPY --from=builder /app /app

WORKDIR /app/Backend/siteSystems

ENV NODE_ENV=production

EXPOSE 4009

CMD ["pnpm", "start"]